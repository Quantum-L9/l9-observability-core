{
  "$id": "urn:quantum-l9:observability:v1:execution-span",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attributes": {
      "$ref": "urn:quantum-l9:observability:v1:definitions#/$defs/Attributes",
      "default": {}
    },
    "completed_at": {
      "$ref": "urn:quantum-l9:observability:v1:definitions#/$defs/Timestamp"
    },
    "duration_ms": {
      "$ref": "urn:quantum-l9:observability:v1:definitions#/$defs/NonNegativeInteger"
    },
    "event_id": {
      "$ref": "urn:quantum-l9:observability:v1:definitions#/$defs/Identifier"
    },
    "event_type": {
      "const": "execution_span"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "$ref": "urn:quantum-l9:observability:v1:evidence-ref"
      },
      "type": "array",
      "uniqueItems": true
    },
    "execution": {
      "$ref": "urn:quantum-l9:observability:v1:execution-context"
    },
    "occurred_at": {
      "$ref": "urn:quantum-l9:observability:v1:definitions#/$defs/Timestamp"
    },
    "schema": {
      "const": "l9.observability.execution-span.v1"
    },
    "span_kind": {
      "$ref": "urn:quantum-l9:observability:v1:definitions#/$defs/SpanKind"
    },
    "started_at": {
      "$ref": "urn:quantum-l9:observability:v1:definitions#/$defs/Timestamp"
    },
    "status": {
      "$ref": "urn:quantum-l9:observability:v1:definitions#/$defs/EventStatus"
    },
    "trace": {
      "$ref": "urn:quantum-l9:observability:v1:trace-context"
    }
  },
  "required": [
    "schema",
    "event_type",
    "event_id",
    "occurred_at",
    "trace",
    "execution",
    "started_at",
    "completed_at",
    "duration_ms",
    "span_kind",
    "status"
  ],
  "type": "object",
  "x-l9-invariants": [
    "completed_at MUST be greater than or equal to started_at",
    "duration_ms MUST equal floor((completed_at - started_at) / 1 millisecond) using exact integer arithmetic"
  ]
}
